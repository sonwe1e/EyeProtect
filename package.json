{
  "name": "eye-protect-pet",
  "version": "2.0.0",
  "description": "Local-first Windows task and healthy work-rhythm assistant.",
  "main": "out/main/index.js",
  "author": "EyeProtect",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:tauri": "tauri dev",
    "build:web": "vite build --config vite.web.config.ts",
    "build:tauri": "tauri build && npm run verify:build",
    "build": "npm run build:tauri",
    "verify:build": "node scripts/verify-tauri-build.mjs",
    "verify:ui-contract": "node scripts/verify-ui-contract.mjs",
    "verify:product": "node scripts/verify-product-boundary.mjs",
    "lint": "npm run verify:product && npm run verify:ui-contract",
    "legacy:build:icon": "electron scripts/build-app-icon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "src-tauri\\target\\release\\eyeprotect.exe",
    "package": "npm run build && node scripts/prepare-tauri-release.mjs",
    "legacy:dev": "electron-vite dev",
    "legacy:build": "electron-vite build && node scripts/verify-build-contract.mjs",
    "legacy:package": "npm run legacy:build && electron-builder --win nsis portable --x64 --publish never",
    "legacy:smoke:simple": "node scripts/smoke-simple-experience.mjs",
    "legacy:smoke:pet-failure": "node scripts/smoke-simple-pet-failure.mjs",
    "smoke:tauri": "node scripts/smoke-tauri.mjs",
    "smoke:tauri-threading": "node scripts/smoke-tauri-threading.mjs",
    "smoke:tauri-write-failure": "node scripts/smoke-tauri-write-failure.mjs",
    "smoke:tauri-task-reminder": "node scripts/smoke-tauri-task-reminder.mjs",
    "smoke:tauri-startup-recovery": "node scripts/smoke-tauri-startup-recovery.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "local.eyeprotect.pet",
    "productName": "EyeProtect",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "public/assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "public/assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "EyeProtect-${version}-win-x64-portable.exe"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "EyeProtect-Setup-${version}-win-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
